# URL local SQLite (cria sentinelai.db na raiz do projeto)
DATABASE_URL=sqlite:///./sentinelai.db
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Assistente: mock por omissão. Para ativar Gemini, define provider=gemini
# e guarda a chave apenas no ambiente do backend (nunca no frontend/GitHub).
ASSISTANT_PROVIDER=mock
GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_API_KEY=adiciona-aqui-apenas-no-teu-ambiente-local

# Para PostgreSQL, usa uma URL semelhante a esta e substitui as credenciais:
# DATABASE_URL=postgresql+psycopg://sentinelai:password@localhost:5432/sentinelai
