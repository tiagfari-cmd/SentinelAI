# URL local SQLite (cria sentinelai.db na raiz do projeto)
DATABASE_URL=sqlite:///./sentinelai.db
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Para PostgreSQL, usa uma URL semelhante a esta e substitui as credenciais:
# DATABASE_URL=postgresql+psycopg://sentinelai:password@localhost:5432/sentinelai
